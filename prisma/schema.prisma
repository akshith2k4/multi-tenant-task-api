generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum WebhookStatus {
  PENDING
  SENDING
  DELIVERED
  DEAD
}

model User {
  id                  String            @id @default(uuid()) @db.Uuid
  email               String            @unique
  passwordHash        String
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(6)
  memberships         Membership[]
  createdOrganizations Organization[]   @relation("OrganizationCreator")
  createdProjects     Project[]         @relation("ProjectCreator")
  assignedTasks       Task[]            @relation("TaskAssignee")
  createdTasks        Task[]            @relation("TaskCreator")
  auditLogs           AuditLog[]
  webhookEndpoints    WebhookEndpoint[]
}

model Organization {
  id           String            @id @default(uuid()) @db.Uuid
  name         String
  createdById  String            @db.Uuid
  createdBy    User              @relation("OrganizationCreator", fields: [createdById], references: [id])
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(6)
  memberships  Membership[]
  projects     Project[]
  tasks        Task[]
  auditLogs    AuditLog[]
  webhookEndpoints WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, organizationId])
  @@index([organizationId, role])
}

model Project {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  description    String?
  createdById    String    @db.Uuid
  createdBy      User      @relation("ProjectCreator", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          Task[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
}

model Task {
  id             String      @id @default(uuid()) @db.Uuid
  projectId      String      @db.Uuid
  organizationId String      @db.Uuid
  title          String
  description    String?
  status         TaskStatus  @default(TODO)
  assigneeId     String?     @db.Uuid
  dueDate        DateTime?   @db.Timestamptz(6)
  reminderSentAt DateTime?   @db.Timestamptz(6)
  createdById    String      @db.Uuid
  createdBy      User        @relation("TaskCreator", fields: [createdById], references: [id])
  assignee       User?       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)
  project        Project     @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId])
  @@index([organizationId, status])
  @@index([assigneeId])
  @@index([dueDate])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  actorId        String   @db.Uuid
  action         String
  targetType     String
  targetId       String   @db.Uuid
  before         Json?
  after          Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  actor          User     @relation(fields: [actorId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, targetType, targetId])
}

model WebhookEndpoint {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  url              String
  secretCiphertext String
  events           String[]
  enabled          Boolean           @default(true)
  createdById      String            @db.Uuid
  createdBy        User              @relation(fields: [createdById], references: [id])
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries       WebhookDelivery[]

  @@index([organizationId, enabled])
}

model WebhookDelivery {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  endpointId     String        @db.Uuid
  eventId        String        @db.Uuid
  eventType      String
  payload        Json
  status         WebhookStatus @default(PENDING)
  attempts       Int           @default(0)
  nextAttemptAt  DateTime?     @db.Timestamptz(6)
  lockedAt       DateTime?     @db.Timestamptz(6)
  lastError      String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
}
